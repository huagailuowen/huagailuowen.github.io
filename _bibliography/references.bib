@article{zhou2026t2z,
  title        = {{T2-z}: Test-Time Optimization of Environment Latents for Robotic World Models},
  author       = {Zhou, Chenyuan and Hong, Yining and Huang, Huang and Jiang, Yunfan and Huang, Wenlong and Held, David and Guizilini, Vitor Campagnolo and Wang, Yue and Li, Fei-Fei and Wu, Jiajun and Guibas, Leonidas and Choi, Yejin},
  journal      = {arXiv preprint arXiv:2610.22364},
  year         = {2026},
  month        = oct,
  abstract     = {We introduce T2-z, a robotic world model augmented with a learnable environment latent that captures unobserved environmental factors without direct supervision. At test time, the world model remains frozen while a newly initialized latent is optimized from one or more interaction trajectories, adapting predictions and action selection to unseen environmental configurations. Across seven simulated settings and four real-world robotic tasks, T2-z improves world prediction and downstream action success while revealing structured latent representations of environmental variation.},
  arxiv        = {2610.22364},
  pdf          = {https://arxiv.org/pdf/2610.22364},
  code         = {https://github.com/T2-z-latent-optimization/T2-z},
  website      = {https://t2-z-latent-optimization.github.io/},
  preview      = {t2z.jpg},
  selected     = {true},
  display_order = {1},
  bibtex_show  = {true}
}

@article{zhou2026a2vla,
  title        = {{A²-VLA}: Adapting Vision-Language-Action Policies to New Tools through Agentic Affordance Discovery},
  author       = {Zhou, Chenyuan and Huang, Chaoyi and Wang, Zibo and Li, Zhiyuan and Li, Yong-Lu},
  journal      = {arXiv preprint arXiv:2611.25656},
  year         = {2026},
  month        = nov,
  abstract     = {A²-VLA combines an embodied agent with a vision-language-action policy for adapting manipulation skills to unseen tools. The agent reconstructs demonstrated scenes in simulation, discovers task-relevant functional regions and geometric affordance features, and refines its extraction skills through autonomous experiments. Validated skills form a reusable library, while encoded affordances condition a pi0.5 policy during training and inference. Experiments report 86.1% success in simulated cross-tool trajectory retargeting and a 30.7 percentage-point improvement over pi0.5 on three real-robot tool-use tasks.},
  arxiv        = {2611.25656},
  pdf          = {https://arxiv.org/pdf/2611.25656},
  preview      = {a2vla.jpg},
  selected     = {true},
  display_order = {2},
  bibtex_show  = {true}
}
